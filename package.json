{
  "name": "amberlink-client",
  "version": "1.0.0",
  "description": "First-party TypeScript client for AmberLink audio servers and compatible third-party nodes.",
  "keywords": [
    "amberlink",
    "amberlink-client",
    "audio",
    "discord",
    "music",
    "node-manager",
    "third-party-nodes",
    "thirdparty-node"
  ],
  "license": "MIT",
  "author": {
    "name": "rahultarafder",
    "url": "https://github.com/RahulTarafder"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "bun": "./dist/index.mjs",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt .",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "tslib": "^2.9.1",
    "ws": "^8.23.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.1.27"
  },
  "packageManager": "npm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RahulTarafder/AmberLink-Client.git"
  },
  "homepage": "https://github.com/RahulTarafder/AmberLink-Client#readme",
  "bugs": {
    "url": "https://github.com/RahulTarafder/AmberLink-Client/issues"
  }
}
